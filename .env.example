# Backend choices: openai, ollama, mock
LLM_BACKEND=openai

# OpenAI / OpenAI-compatible endpoint
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama fallback
OLLAMA_BASE_URL=http://localhost:11434
